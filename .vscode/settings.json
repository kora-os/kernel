    "cSpell.diagnosticLevel": "Hint",
    "clangd.arguments": ["--background-index", "--header-insertion=never"],
    "editor.inlayHints.enabled": "on",
    "editor.inlayHints.parameterHints": true,
    "editor.inlayHints.variableHints": true,
    "editor.inlayHints.functionHints": true,
    "editor.inlayHints.typeHints": true,
}
